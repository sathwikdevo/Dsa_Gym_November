class Solution:
    def capitalizeTitle(self, title: str) -> str:
        chars = list(title)
        n = len(chars)
        
        i = 0
        while i < n:
            start = i
            # Find the end of the current word
            while i < n and chars[i] != ' ':
                i += 1
            end = i
            
            length = end - start
            
            # If word length is 1 or 2, convert all letters to lowercase
            if length <= 2:
                for j in range(start, end):
                    if 65 <= ord(chars[j]) <= 90:
                        chars[j] = chr(ord(chars[j]) + 32)
            # Otherwise, capitalize the first letter and lowercase the rest
            else:
                # First letter -> Uppercase
                if 97 <= ord(chars[start]) <= 122:
                    chars[start] = chr(ord(chars[start]) - 32)
                
                # Remaining letters -> Lowercase
                for j in range(start + 1, end):
                    if 65 <= ord(chars[j]) <= 90:
                        chars[j] = chr(ord(chars[j]) + 32)
                        
            # Skip the space separator
            i += 1
            
        return "".join(chars)