class Solution(object):
    def longestCommonPrefix(self, strs):
        """
        :type strs: List[str]
        :rtype: str
        """
        if not strs:
            return ""
        
        # Start by assuming the entire first string is the common prefix
        prefix = strs[0]
        
        # Compare the prefix with every other string in the list
        for i in range(1, len(strs)):
            current_str = strs[i]
            j = 0
            
            # Compare character by character manually without built-in methods
            while j < len(prefix) and j < len(current_str):
                if prefix[j] != current_str[j]:
                    break
                j += 1
            
            # Reduce the prefix to the matching portion found
            prefix = prefix[:j]
            
            # Early exit if the prefix becomes empty
            if not prefix:
                return ""
                
        return prefix