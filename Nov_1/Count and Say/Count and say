class Solution(object):
    def countAndSay(self, n):
        """
        :type n: int
        :rtype: str
        """
        # Base case
        current = "1"
        
        # Build the sequence up to the n-th term iteratively
        for _ in range(n - 1):
            next_string = []
            i = 0
            length = len(current)
            
            while i < length:
                # Count consecutive identical digits
                count = 1
                while i + 1 < length and current[i] == current[i + 1]:
                    count += 1
                    i += 1
                
                # Append the frequency and the digit itself
                next_string.append(str(count))
                next_string.append(current[i])
                i += 1
            
            current = "".join(next_string)
            
        return current