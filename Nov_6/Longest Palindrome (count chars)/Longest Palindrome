class Solution(object):
    def longestPalindrome(self, s):
        """
        :type s: str
        :rtype: int
        """
        # Dictionary to store character frequencies without using Counter
        char_count = {}
        for char in s:
            if char in char_count:
                char_count[char] += 1
            else:
                char_count[char] = 1

        length = 0
        has_odd = False

        for char in char_count:
            count = char_count[char]
            # Add the largest even amount of each character
            length += (count // 2) * 2
            
            # If the count is odd, we can use one odd character in the center
            if count % 2 != 0:
                has_odd = True

        # If there is at least one character with an odd frequency, 
        # we can place one in the exact middle of the palindrome
        if has_odd:
            length += 1

        return length